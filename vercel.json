{
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/jamaah",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/backoffice",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/tentang",
      "destination": "/tentang.html"
    },
    {
      "source": "/profil",
      "destination": "/tentang.html"
    },
    {
      "source": "/sambutan",
      "destination": "/sambutan.html"
    },
    {
      "source": "/muthawwif",
      "destination": "/muthawwif.html"
    },
    {
      "source": "/legalitas",
      "destination": "/legalitas.html"
    }
  ]
}
