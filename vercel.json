{
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/jamaah",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/backoffice",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    }
  ]
}
